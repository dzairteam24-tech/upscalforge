{
  "permissions": {
    "deny": [
      "Edit(.claude/skills/**)",
      "Edit(.claude/hooks/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-skills.sh\"" }
        ]
      }
    ]
  }
}
