{
  "name": "CubelingNest",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "game/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "game/server"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "CameraMaxZoomDistance": 60
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "game/client"
        }
      }
    },
    "Lighting": {
      "$properties": {
        "ClockTime": 14,
        "Brightness": 2,
        "GlobalShadows": true
      },
      "Atmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.32,
          "Offset": 0.15,
          "Haze": 1.4,
          "Glare": 0,
          "Color": [
            0.8,
            0.87,
            0.95
          ],
          "Decay": [
            0.55,
            0.65,
            0.78
          ]
        }
      }
    },
    "Workspace": {
      "$properties": {
        "FallenPartsDestroyHeight": -200
      }
    }
  }
}
