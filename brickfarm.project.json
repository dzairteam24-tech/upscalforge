    "Lighting": {
      "$properties": {
        "ClockTime": 14,
        "Brightness": 2.4,
        "GlobalShadows": true
      }
    },
    "Workspace": {
      "$properties": {
        "FallenPartsDestroyHeight": -200
      }
    }
  }
}
