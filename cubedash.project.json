{
  "name": "Cubedash",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": { "$path": "cubedash/shared" }
    },
    "ServerScriptService": {
      "Server": { "$path": "cubedash/server" }
    },
    "StarterPlayer": {
      "$properties": {
        "CameraMaxZoomDistance": 45
      },
      "StarterPlayerScripts": {
        "Client": { "$path": "cubedash/client" }
      }
    },
    "Lighting": {
      "$properties": {
        "ClockTime": 0,
        "Brightness": 0.6,
        "GlobalShadows": false,
        "Ambient": [0.18, 0.2, 0.32],
        "OutdoorAmbient": [0.16, 0.18, 0.3],
        "EnvironmentDiffuseScale": 0.4,
        "EnvironmentSpecularScale": 0.4
      }
    },
    "Workspace": {
      "$properties": {
        "FallenPartsDestroyHeight": -400
      }
    }
  }
}
