# Build output
/build/
sourcemap.json
*.rbxl
*.rbxlx
*.rbxl.lock
*.rbxlx.lock
__pycache__/

# Art scratch outputs (regenerated by art/blender/cubelings.py and art/viewer/build.py).
# The game only uses art/models/Cubelings_Roblox.glb; the per-creature .glb, palettes and renders stay committed.
art/models/*.fbx
art/renders/*lineup*.png
art/renders/_*.png
*-3d.html
*_3D.html

# Store art scratch renders
art/store/_render/
art/store/_*.png
